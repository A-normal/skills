{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/profile-curator/run-result.schema.json",
  "title": "Profile Curator successful run checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "completedAt",
    "status",
    "recordsProcessed",
    "backlogRemaining",
    "sourceWatermarks"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "completedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["no_change", "updated", "review_required"] },
    "recordsProcessed": { "type": "integer", "minimum": 0 },
    "backlogRemaining": { "type": "integer", "minimum": 0 },
    "sourceWatermarks": {
      "type": "object",
      "additionalProperties": { "type": "string", "maxLength": 500 }
    }
  }
}
