{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/profile-curator/baseline-review.schema.json",
  "title": "Profile Curator USER.md baseline review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetPath", "targetSha256", "reviewedAt", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "targetPath": { "type": "string", "minLength": 1, "maxLength": 500 },
    "targetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateId", "status", "summary"],
        "properties": {
          "candidateId": { "type": "string", "minLength": 1, "maxLength": 80 },
          "status": {
            "enum": ["absent", "managed_existing", "already_present", "conflict", "uncertain"]
          },
          "summary": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
